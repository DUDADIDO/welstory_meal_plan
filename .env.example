# 웰스토리 Plus 로그인 계정 (필수)
WELSTORY_USERNAME=
WELSTORY_PASSWORD=

# 어드민 콘솔(/admin) 로그인 계정 (필수, 충분히 긴 비밀번호 권장)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# PostgreSQL
POSTGRES_DB=welstory
POSTGRES_USER=welstory
POSTGRES_PASSWORD=change-this-postgres-password

# 외부 공개 포트
APP_PORT=8080

# 필요할 때만 변경
WELSTORY_RESTAURANT_CODE=REST000595
WELSTORY_RESTAURANT_NAME=삼성전기 부산사업장
WELSTORY_MEAL_TYPE=2

# 녹산산업단지 일대의 현재 날씨 조회 좌표
WEATHER_LATITUDE=35.09
WEATHER_LONGITUDE=128.87

# 기상청 단기예보 조회서비스 인증키 (있으면 기상청, 없으면 Open-Meteo)
KMA_SERVICE_KEY=
